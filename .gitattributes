# Line endings: LF in the repository, LF on checkout, except the Windows
# batch launcher, which cmd.exe expects with CRLF.
*           text=auto eol=lf
*.cmd       text eol=crlf
*.bat       text eol=crlf

*.py        text diff=python
*.md        text diff=markdown
*.json      text
*.toml      text
*.yml       text
*.yaml      text
*.ps1       text
*.html      text
*.css       text
*.js        text
*.svg       text
*.txt       text
*.csv       text
*.xml       text
*.log       text

# Binary assets and captures are never touched.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.ico       binary
*.exe       binary
*.docx      binary
*.dotx      binary
*.xlsx      binary
*.blg       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.zip       binary
