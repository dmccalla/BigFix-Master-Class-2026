# ---------------------------------------------------------------------------
# Master Class Diagnostics Workbench: ignore rules
# Keep the repo to source, sample data, and the shipped utilities. Anything a
# script regenerates or a tool produces does not belong in git.
# ---------------------------------------------------------------------------

# Python bytecode and caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.uv-cache/

# Private per-tool virtual environment created by the launcher
.venv/
venv/

# Build configs written by older versions next to the code (now under
# %LOCALAPPDATA%\Master Class Diagnostics Workbench)
*.ui.config.json

# Editor settings and agent scratch
.vscode/
.claude/
.agents/
.codex/

# OS and editor junk
.DS_Store
Thumbs.db
*.stackdump
*~

# Microsoft Office lock files
~$*

# Scratch space and generated output
Temp/
Output/
Dist/

# Lab sample data. Its Perfmon capture is over GitHub's 100 MB file limit, so it
# ships in the release zip and as Sample-Data-Results.zip on the release.
SampleData/BigFix Master Class 2026/Results/
