//* ====================================================================================================>
//*
//*     BACKUP EXISTING FILES, IF PRESENT.  
//*
//* ====================================================================================================>

if {exists folder (parameter "deploymentInfoResultsFolder")}
waithidden cmd.exe /C mkdir {parameter "deploymentInfoResultsBackupFolder"} 
waithidden cmd.exe /C xcopy "{parameter "deploymentInfoResultsFolder"}" "{parameter "deploymentInfoResultsBackupFolder"}" /E /Y
endif

//* ====================================================================================================>
//*
//*     DELETE ANY EXISTING FOLDERS, SCRIPTS, ETC. SO WE CAN CREATE FRESH CONTENT
//*
//* ====================================================================================================>

waithidden cmd.exe /C rd /s /q "{parameter "deploymentInfoResultsFolder"}"
waithidden cmd.exe /C rd /s /q "{parameter "toolsFolder"}"

//* ====================================================================================================>
//*
//*     BUILD OUT THE FOLDER STRUCTURE TO SUPPORT THE TASK
//*
//* ====================================================================================================>

waithidden cmd.exe /C mkdir {parameter "rootFolder"}
waithidden cmd.exe /C mkdir {parameter "deploymentInfoResultsFolder"}
waithidden cmd.exe /C mkdir "{parameter "diGeneralFolder"}"
waithidden cmd.exe /C mkdir "{parameter "diServerFolder"}"
waithidden cmd.exe /C mkdir "{parameter "diRelaysFolder"}"
waithidden cmd.exe /C mkdir "{parameter "diClientsFolder"}"
waithidden cmd.exe /C mkdir "{parameter "diContentFolder"}"
waithidden cmd.exe /C mkdir "{parameter "diOperatorsFolder"}"

//* ====================================================================================================>
//*
//*     LOGIN TO THE API
//*
//* ====================================================================================================>

waithidden cmd.exe /C ""{parameter "cliFolder" & "\iem"}" login -q --server=https://{if ((parameter "rootServerName") != "") then (parameter "rootServerName") else (host name of root server)}:{parameter "apiPort"} --user={parameter "apiUsername"} --password={parameter "apiPassword"} --masthead="{preceding text of last "\" of pathname of data folder of client & "\actionsite.afxm"}""

//* ====================================================================================================>
//*
//*     CAPTURE GENERAL DEPLOYMENT INFORMATION
//*
//* ====================================================================================================>

if {parameter "collectGeneral" = "true"}

waithidden cmd.exe /C "{parameter "cliFolder" & "\iem"}" GET query --relevance=%28%22GENERAL%20DEPLOYMENT%20INFORMATION%22%29 > {parameter "generalInfoFileXML"}
waithidden cmd.exe /C ping -n {(parameter "apiQueryDelaySeconds" as integer) + 1} 127.0.0.1
waithidden cmd.exe /C "{parameter "cliFolder" & "\iem"}" GET query --relevance=%28%22%20%22%29 >> {parameter "generalInfoFileXML"}
waithidden cmd.exe /C ping -n {(parameter "apiQueryDelaySeconds" as integer) + 1} 127.0.0.1
waithidden cmd.exe /C "{parameter "cliFolder" & "\iem"}" GET query --relevance=%22Report%20Generated%3A%20%22%20%26%20now%20as%20string >> {parameter "generalInfoFileXML"}
waithidden cmd.exe /C ping -n {(parameter "apiQueryDelaySeconds" as integer) + 1} 127.0.0.1
waithidden cmd.exe /C "{parameter "cliFolder" & "\iem"}" GET query --relevance=%28%22Report%20Version%3A%201.0%22%29 >> {parameter "generalInfoFileXML"}
waithidden cmd.exe /C ping -n {(parameter "apiQueryDelaySeconds" as integer) + 1} 127.0.0.1
