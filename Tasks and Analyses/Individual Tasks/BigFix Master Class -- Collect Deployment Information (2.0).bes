//*
//* 		Parse the XML and format things so they are human readable. 
//*

if {(parameter "generateLogFiles" | "0") = "1"}
delete __appendfile
delete "{parameter "operatorInfoFile"}"
appendfile {concatenation "%0d%0a" of (preceding texts of firsts "<" of following texts of firsts ">" of lines whose (it contains "Answer") of file (parameter "operatorInfoFileXML"))}
move __appendfile "{parameter "operatorInfoFile"}"
endif

