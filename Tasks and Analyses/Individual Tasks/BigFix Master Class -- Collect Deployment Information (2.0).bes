waithidden cmd.exe /C ping -n {(parameter "apiQueryDelaySeconds" as integer) + 1} 127.0.0.1
waithidden cmd.exe /C "{parameter "cliFolder" & "\iem"}" GET query --relevance=%22Number%20of%20Active%20BES%20Relays%3A%20%22%20%26%20number%20of%20computers%20of%20results%20from%20%28bes%20properties%20%22Last%20Report%20Time%22%20whose%20%28reserved%20flag%20of%20it%29%29%20whose%20%28exists%20value%20of%20it%20and%20%28now%20-%20value%20of%20it%20as%20time%29%20%3C%201%20%2A%20day%29%20of%20%28computers%20of%20results%20whose%20%28exists%20value%20of%20it%20AND%20value%20of%20it%20as%20lowercase%20contains%20%22yes%22%29%20of%20bes%20properties%20%22BES%20Relay%20Service%20Installed%22%20whose%20%28reserved%20flag%20of%20it%29%29%20as%20string >> {parameter "relayServerInfoFileXML"}
waithidden cmd.exe /C ping -n {(parameter "apiQueryDelaySeconds" as integer) + 1} 127.0.0.1
waithidden cmd.exe /C "{parameter "cliFolder" & "\iem"}" GET query --relevance=%22Number%20of%20Computers%20Using%20Automatic%20Relay%20Selection%3A%20%22%20%26%20number%20of%20results%20whose%20%28exists%20value%20of%20it%20AND%20value%20of%20it%20%3D%20%22Automatic%22%29%20of%20bes%20properties%20%22BES%20Relay%20Selection%20Method%22%20whose%20%28reserved%20flag%20of%20it%29%20as%20string >> {parameter "relayServerInfoFileXML"}
waithidden cmd.exe /C ping -n {(parameter "apiQueryDelaySeconds" as integer) + 1} 127.0.0.1
