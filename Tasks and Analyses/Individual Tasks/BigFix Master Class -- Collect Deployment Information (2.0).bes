waithidden cmd.exe /C ping -n {(parameter "apiQueryDelaySeconds" as integer) + 1} 127.0.0.1
waithidden cmd.exe /C "{parameter "cliFolder" & "\iem"}" GET query --relevance=%22Deployment%20Age%3A%20%22%20%26%20%28%28now%20-%20%28minimum%20of%20%28creation%20times%20of%20bes%20users%29%29%29%20%2F%20day%20%29%20as%20string%20as%20string >> {parameter "generalInfoFileXML"}
waithidden cmd.exe /C ping -n {(parameter "apiQueryDelaySeconds" as integer) + 1} 127.0.0.1
