//*
//* 		Parse the XML and format things so they are human readable. 
//*

if {(parameter "generateLogFiles" | "0") = "1"}
delete __appendfile
delete "{parameter "actionInfoFile"}"
appendfile {concatenation "%0d%0a" of (preceding texts of firsts "<" of following texts of firsts ">" of lines whose (it contains "Answer") of file (parameter "actionInfoFileXML"))}
move __appendfile "{parameter "actionInfoFile"}"
endif

else
waithidden cmd.exe /C echo Action information was not selected for capture. > {parameter "diContentFolder" & "\ACTION_INFO_NOT_SELECTED.txt"}
endif

