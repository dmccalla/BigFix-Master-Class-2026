//*
//* 		Parse the XML and format things so they are human readable. 
//*

if {(parameter "generateLogFiles" | "0") = "1"}
delete __appendfile
delete "{parameter "clientInfoFile"}"
appendfile {concatenation "%0d%0a" of (preceding texts of firsts "<" of following texts of firsts ">" of lines whose (it contains "Answer") of file (parameter "clientInfoFileXML"))}
move __appendfile "{parameter "clientInfoFile"}"
endif

else
waithidden cmd.exe /C echo Client information was not selected for capture. > "{parameter "diClientsFolder" & "\CLIENT_INFO_NOT_SELECTED.txt"}"
endif

