waithidden cmd.exe /C "{parameter "cliFolder" & "\iem"}" GET query --relevance=%22Maximum%20Number%20of%20Clients%20per%20Relay%3A%20%22%20%26%20%28%28if%20%28exists%20results%20whose%20%28exists%20value%20of%20it%20and%20value%20of%20it%20%21%3D%20%22BES%20Root%20Server%22%29%20of%20bes%20properties%20%22Relay%22%20whose%20%28reserved%20flag%20of%20it%29%29%20then%20%28maximum%20of%20multiplicities%20of%20unique%20values%20of%20values%20of%20results%20whose%20%28exists%20value%20of%20it%20and%20value%20of%20it%20%21%3D%20%22BES%20Root%20Server%22%29%20of%20bes%20properties%20%22Relay%22%20whose%20%28reserved%20flag%20of%20it%29%29%20else%200%29%20as%20string%29 >> {parameter "relayServerInfoFileXML"}
waithidden cmd.exe /C ping -n {(parameter "apiQueryDelaySeconds" as integer) + 1} 127.0.0.1
