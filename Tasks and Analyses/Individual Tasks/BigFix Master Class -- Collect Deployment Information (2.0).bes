//*
//* 		Parse the XML and format things so they are human readable. 
//*

if {(parameter "generateLogFiles" | "0") = "1"}
delete __appendfile
delete "{parameter "generalInfoFile"}"
appendfile {concatenation "%0d%0a" of (preceding texts of firsts "<" of following texts of firsts ">" of lines whose (it contains "Answer") of file (parameter "generalInfoFileXML"))}
move __appendfile "{parameter "generalInfoFile"}"
endif

//*
//* 		Some things cannot be retrieved via the API or we want to use client relevance instead.  That can go here.
//*

if {(parameter "generateLogFiles" | "0") = "1"}
waithidden cmd.exe /C echo {"Actionsite Size: " & (sum of sizes of files of folder ((preceding text of first "BESClient.exe" of pathname of regapps "BESClient.exe") & "__BESData\actionsite") / 1000) as string & " KB"} >> {parameter "generalInfoFile"}

//*
//* 		Some API calls return data in a different format than the GET query calls above. We grab admin options and fields here and parse the XML responses.
//*

waithidden cmd.exe /C "{parameter "cliFolder" & "\iem"}" GET admin/fields >> {parameter "generalInfoFileAdminToolFieldsXML"}
waithidden cmd.exe /C ping -n {(parameter "apiQueryDelaySeconds" as integer) + 1} 127.0.0.1
waithidden cmd.exe /C "{parameter "cliFolder" & "\iem"}" GET admin/options >> {parameter "generalInfoFileAdminToolOptionsXML"}
waithidden cmd.exe /C ping -n {(parameter "apiQueryDelaySeconds" as integer) + 1} 127.0.0.1

//*
//* 		Parse the Admin Tool Options and Fields XML files and format things so they are human readable. 
//*

if {if exists files (parameter "generalInfoFileAdminToolFieldsXML") whose (size of it > 0) then exists xml documents of files (parameter "generalInfoFileAdminToolFieldsXML") else false}
waithidden cmd.exe /C echo {(node values of child nodes of xpaths "Name" of it, node values of child nodes of xpaths "Value" of it) of xpaths "/BESAPI/AdminField" of xml documents of files (parameter "generalInfoFileAdminToolFieldsXML")} >> {parameter "generalInfoFile"}
else
waithidden cmd.exe /C echo Admin Tool fields were not available to the supplied API account. >> {parameter "generalInfoFile"}
endif

if {if exists files (parameter "generalInfoFileAdminToolOptionsXML") whose (size of it > 0) then exists xml documents of files (parameter "generalInfoFileAdminToolOptionsXML") else false}
waithidden cmd.exe /C echo {(node name of it, node values of child nodes of it) of child nodes of child nodes of child nodes of xml documents of files (parameter "generalInfoFileAdminToolOptionsXML")} >> {parameter "generalInfoFile"}
else
waithidden cmd.exe /C echo Admin Tool options were not available to the supplied API account. >> {parameter "generalInfoFile"}
endif
endif

else
waithidden cmd.exe /C echo General deployment information was not selected for capture. > "{parameter "diGeneralFolder" & "\GENERAL_INFO_NOT_SELECTED.txt"}"
endif


//* ====================================================================================================>
//*
//*     CAPTURE ROOT SERVER INFORMATION
//*
//* ====================================================================================================>

if {parameter "collectRootServer" = "true"}
waithidden cmd.exe /C "{parameter "cliFolder" & "\iem"}" GET query --relevance=%28%22ROOT%20SERVER%20INFORMATION%22%29 > {parameter "rootServerInfoFileXML"}
waithidden cmd.exe /C ping -n {(parameter "apiQueryDelaySeconds" as integer) + 1} 127.0.0.1
waithidden cmd.exe /C "{parameter "cliFolder" & "\iem"}" GET query --relevance=%28%22%20%22%29 >> {parameter "rootServerInfoFileXML"}
waithidden cmd.exe /C ping -n {(parameter "apiQueryDelaySeconds" as integer) + 1} 127.0.0.1
waithidden cmd.exe /C "{parameter "cliFolder" & "\iem"}" GET query --relevance=%22Report%20Generated%3A%20%22%20%26%20now%20as%20string >> {parameter "rootServerInfoFileXML"}
waithidden cmd.exe /C ping -n {(parameter "apiQueryDelaySeconds" as integer) + 1} 127.0.0.1
waithidden cmd.exe /C "{parameter "cliFolder" & "\iem"}" GET query --relevance=%28%22Report%20Version%3A%201.0%22%29 >> {parameter "rootServerInfoFileXML"}
waithidden cmd.exe /C ping -n {(parameter "apiQueryDelaySeconds" as integer) + 1} 127.0.0.1
waithidden cmd.exe /C "{parameter "cliFolder" & "\iem"}" GET query --relevance=%28%22%20%22%29 >> {parameter "rootServerInfoFileXML"}
waithidden cmd.exe /C ping -n {(parameter "apiQueryDelaySeconds" as integer) + 1} 127.0.0.1
waithidden cmd.exe /C "{parameter "cliFolder" & "\iem"}" GET query --relevance=%22BES%20Server%20Version%20Counts%3A%20%22%20%26%20concatenation%20%22%2C%20%22%20of%20%28it%20as%20string%29%20of%20%28it%20%26%20%22--%22%20%26%20%28multiplicity%20of%20it%20as%20string%29%29%20of%20unique%20values%20of%20values%20whose%20%28it%20contains%20%22.%22%29%20of%20results%20whose%20%28not%20error%20flag%20of%20it%20and%20exists%20value%20of%20it%29%20of%20bes%20property%20whose%20%28name%20of%20it%20%3D%20%22BES%20Server%20Version%22%20and%20name%20of%20site%20of%20source%20analysis%20of%20it%20%3D%20%22BES%20Support%22%29%20as%20string >> {parameter "rootServerInfoFileXML"}
waithidden cmd.exe /C ping -n {(parameter "apiQueryDelaySeconds" as integer) + 1} 127.0.0.1
waithidden cmd.exe /C "{parameter "cliFolder" & "\iem"}" GET query --relevance=%22BES%20Api%20Version%20Counts%3A%20%22%20%26%20concatenation%20%22%2C%20%22%20of%20%28it%20as%20string%29%20of%20%28it%20%26%20%22--%22%20%26%20%28multiplicity%20of%20it%20as%20string%29%29%20of%20unique%20values%20of%20values%20whose%20%28it%20contains%20%22.%22%29%20of%20results%20whose%20%28not%20error%20flag%20of%20it%20and%20exists%20value%20of%20it%29%20of%20bes%20property%20whose%20%28name%20of%20it%20%3D%20%22BES%20API%20Version%22%20and%20name%20of%20site%20of%20source%20analysis%20of%20it%20%3D%20%22BES%20Support%22%29%20as%20string >> {parameter "rootServerInfoFileXML"}
waithidden cmd.exe /C ping -n {(parameter "apiQueryDelaySeconds" as integer) + 1} 127.0.0.1
waithidden cmd.exe /C "{parameter "cliFolder" & "\iem"}" GET query --relevance=%22Number%20of%20Computers%20on%20BES%20Server%3A%20%22%20%26%20number%20of%20values%20whose%20%28gather%20url%20of%20bes%20license%20as%20lowercase%20contains%20it%20as%20lowercase%29%20of%20results%20whose%20%28exists%20value%20of%20it%29%20of%20bes%20properties%20%22Relay%22%20whose%20%28reserved%20flag%20of%20it%29%20as%20string >> {parameter "rootServerInfoFileXML"}
waithidden cmd.exe /C ping -n {(parameter "apiQueryDelaySeconds" as integer) + 1} 127.0.0.1
waithidden cmd.exe /C "{parameter "cliFolder" & "\iem"}" GET query --relevance=%22BES%20Server%20CPU%3A%20%22%20%26%20concatenation%20%22%2C%20%22%20of%20values%20of%20results%20from%20%28bes%20properties%20%22CPU%22%29%20whose%20%28exists%20value%20of%20it%29%20of%20computers%20of%20results%20whose%20%28exists%20value%20of%20it%20and%20value%20of%20it%20%3D%20%22BES%20Root%20Server%22%20or%20value%20of%20it%20%3D%20%22Main%20BES%20Server%22%29%20of%20bes%20properties%20%22Relay%22%20whose%20%28reserved%20flag%20of%20it%29%20as%20string >> {parameter "rootServerInfoFileXML"}
waithidden cmd.exe /C ping -n {(parameter "apiQueryDelaySeconds" as integer) + 1} 127.0.0.1
waithidden cmd.exe /C "{parameter "cliFolder" & "\iem"}" GET query --relevance=%22BES%20Server%20RAM%3A%20%22%20%26%20concatenation%20%22%2C%20%22%20of%20values%20of%20results%20from%20%28bes%20properties%20%22RAM%22%29%20whose%20%28exists%20value%20of%20it%29%20of%20computers%20of%20results%20whose%20%28exists%20value%20of%20it%20and%20value%20of%20it%20%3D%20%22BES%20Root%20Server%22%20or%20value%20of%20it%20%3D%20%22Main%20BES%20Server%22%29%20of%20bes%20properties%20%22Relay%22%20whose%20%28reserved%20flag%20of%20it%29%20as%20string >> {parameter "rootServerInfoFileXML"}
waithidden cmd.exe /C ping -n {(parameter "apiQueryDelaySeconds" as integer) + 1} 127.0.0.1
waithidden cmd.exe /C "{parameter "cliFolder" & "\iem"}" GET query --relevance=%22BES%20Server%20OS%3A%20%22%20%26%20concatenation%20%22%2C%20%22%20of%20values%20of%20results%20from%20%28bes%20properties%20%22OS%22%29%20whose%20%28exists%20value%20of%20it%29%20of%20computers%20of%20results%20whose%20%28exists%20value%20of%20it%20and%20value%20of%20it%20%3D%20%22BES%20Root%20Server%22%20or%20value%20of%20it%20%3D%20%22Main%20BES%20Server%22%29%20of%20bes%20properties%20%22Relay%22%20whose%20%28reserved%20flag%20of%20it%29%20as%20string >> {parameter "rootServerInfoFileXML"}
waithidden cmd.exe /C ping -n {(parameter "apiQueryDelaySeconds" as integer) + 1} 127.0.0.1
waithidden cmd.exe /C "{parameter "cliFolder" & "\iem"}" GET query --relevance=%22BES%20Server%20Hardware%20Information%3A%20%22%20%26%20concatenation%20%22%2C%20%22%20of%20%28it%20as%20string%29%20of%20%28it%20%26%20%22--%22%20%26%20%28multiplicity%20of%20it%20as%20string%29%29%20of%20unique%20values%20of%20%28it%20as%20trimmed%20string%29%20of%20values%20of%20%28results%20%28properties%20of%20bes%20fixlets%20whose%20%28analysis%20flag%20of%20it%20%3D%20TRUE%20AND%20name%20of%20it%20as%20lowercase%20contains%20%22hardware%20information%22%29%2C%20it%29%20whose%20%28exists%20value%20of%20it%29%29%20of%20bes%20computers%20whose%20%28exists%20value%20of%20result%20%28bes%20properties%20%22Relay%22%20whose%20%28reserved%20flag%20of%20it%29%2Cit%29%20and%20%28value%20of%20result%20%28bes%20properties%20%22Relay%22%20whose%20%28reserved%20flag%20of%20it%29%2Cit%29%20%3D%20%22BES%20Root%20Server%22%20or%20value%20of%20result%20%28bes%20properties%20%22Relay%22%20whose%20%28reserved%20flag%20of%20it%29%2Cit%29%20%3D%20%22Main%20BES%20Server%22%29%29%20as%20string >> {parameter "rootServerInfoFileXML"}
waithidden cmd.exe /C ping -n {(parameter "apiQueryDelaySeconds" as integer) + 1} 127.0.0.1

//*
//* 		Parse the XML and format things so they are human readable. 
//*

if {(parameter "generateLogFiles" | "0") = "1"}
delete __appendfile
delete "{parameter "rootServerInfoFile"}"
appendfile {concatenation "%0d%0a" of (preceding texts of firsts "<" of following texts of firsts ">" of lines whose (it contains "Answer") of file (parameter "rootServerInfoFileXML"))}
move __appendfile "{parameter "rootServerInfoFile"}"
endif

//*
//* 		Some things cannot be retrieved via the API or we want to use client relevance instead.  That can go here.
//*

waithidden cmd.exe /C echo {concatenation "; " of (((name of it & " - Total Space: " & (total space of it / 1024 / 1024) as string & "MB") & " - Free Space: " & ((free space of it / 1024 / 1024) as string & "MB")) of drives whose (type of it = "DRIVE_FIXED"))} >> "{parameter "rootServerInfoFile"}"
waithidden cmd.exe /C echo {"FillDB Log File Size: " & (if (it > 0) then (if (it < (1024*1024) ) then ((it / 1024) as string & " KB") else ((it / (1024*1024)) as string & " MB")) else ("N/A")) of (if (name of operating system starts with "Win") then (if (exists service "BESRootServer") then (size of file (value "DataDirectoryPath" of key "HKEY_LOCAL_MACHINE\SOFTWARE\BigFix\Enterprise Server\FillDB" of x32 registry as string & "\FillDB.log")) else (-1)) else (if (exists main gather service) then (size of file (key ("DebugOut") of section ("Software\BigFix\Enterprise Server\FillDB") of file "/var/opt/BESServer/besserver.config")) else (-1)))} >> "{parameter "rootServerInfoFile"}"
waithidden cmd.exe /C echo {"Number of Files in Buffer Dir: " & (if (exists main gather service) then ((number of files of it + number of files of folders of it) of folder (if (name of operating system starts with "Win") then (value "BufferDir" of key "HKEY_LOCAL_MACHINE\SOFTWARE\BigFix\Enterprise Server\FillDB" of registry as string) else (key ("BufferDir") of section ("Software\BigFix\Enterprise Server\FillDB") of file "besserver.config" of parent folder of folder (value of setting "_BESRelay_HTTPServer_ServerRootPath" of client)))as string) else ("N/A"))} >> "{parameter "rootServerInfoFile"}"
waithidden cmd.exe /C echo {"Buffer Dir Size: " & (if (exists main gather service) then ((number of files of it + number of files of folders of it) of folder (if (name of operating system starts with "Win") then (value "BufferDir" of key "HKEY_LOCAL_MACHINE\SOFTWARE\BigFix\Enterprise Server\FillDB" of registry as string) else (key ("BufferDir") of section ("Software\BigFix\Enterprise Server\FillDB") of file "besserver.config" of parent folder of folder (value of setting "_BESRelay_HTTPServer_ServerRootPath" of client)))as string) else ("N/A"))} >> "{parameter "rootServerInfoFile"}"
//waithidden cmd.exe /C echo {"Gather Status Failures: " &  (concatenation "  ||  " of lines whose (it as lowercase contains "gathererror" and it as lowercase does not contain "shutdown while in gatherpending" and it as lowercase does not contain "hasite_") of file (if (name of operating system starts with "Win") then (if ((value whose (name of it as string as lowercase contains "version") of key "HKLM\Software\BigFix\Enterprise Server\" of registry as string) < "8") then (value "InboxLocation" of key "HKEY_LOCAL_MACHINE\SOFTWARE\BigFix\Enterprise Server\GatherService" of registry as string & "\GatherState.xml") else ((value "StoragePath" of key "HKEY_LOCAL_MACHINE\Software\BigFix\Enterprise Server\GlobalOptions" of registry as string) & "Mirror Server\inbox\GatherState.xml")) else (pathname of parent folder of folder (value of setting "_BESRelay_HTTPServer_ServerRootPath" of client) & "/Mirror Server/inbox/GatherState.xml"))) } >> "{parameter "rootServerInfoFile"}"
waithidden cmd.exe /C echo {"Registration List Size: " & (if (exists file(it)) then ((size of file (it) / 1024) as string & " KB") else "N/A") of (if (name of operating system starts with "Win") then (value "RegistrationList Location" of key "HKEY_LOCAL_MACHINE\SOFTWARE\BigFix\Enterprise Server\ClientRegister" of registry as string) else (pathname of parent folder of folder (value of setting "_BESRelay_HTTPServer_ServerRootPath" of client) & "/ClientRegisterData/registrationlist.txt"))} >> "{parameter "rootServerInfoFile"}"
waithidden cmd.exe /C echo {"Web Reports SSL: " & (if (exists service "BESWebReportsServer") then (if (exists setting "_WebReports_HTTPServer_UseSSLFlag" whose (value of it = "1") of client) then ("HTTPS") else ("HTTP")) else ("N/A"))} >> "{parameter "rootServerInfoFile"}"
waithidden cmd.exe /C echo {"FillDB Parallelism (Number of DB Updating Threads): " & (value "NumberOfDBUpdatingThreads" of key "HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\BigFix\Enterprise Server\FillDB" of x32 registry as string)}  >> "{parameter "rootServerInfoFile"}"
waithidden cmd.exe /C echo {"FillDB Parallelism (Number of DB Updating Threads for Query): " & (value "NumberOfDBUpdatingThreadsForQuery" of key "HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\BigFix\Enterprise Server\FillDB" of x32 registry as string)}  >> "{parameter "rootServerInfoFile"}"
waithidden cmd.exe /C echo {"FillDB Parallelism (Number of Parsing Threads): " & (value "NumberOfParsingThreads" of key "HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\BigFix\Enterprise Server\FillDB" of x32 registry as string)}  >> "{parameter "rootServerInfoFile"}"
waithidden cmd.exe /C echo {"FillDB Parallelism (Number of Parsing Threads For Query): " & (value "NumberOfParsingThreadsForQuery" of key "HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\BigFix\Enterprise Server\FillDB" of x32 registry as string)}  >> "{parameter "rootServerInfoFile"}"
waithidden cmd.exe /C echo {"FillDB Parallelism (Parallelism Enabled): " & (value "ParallelismEnabled" of key "HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\BigFix\Enterprise Server\FillDB" of x32 registry as string)}  >> "{parameter "rootServerInfoFile"}"
waithidden cmd.exe /C echo {"FillDB Parallelism (Parallelism Enabled For Query): " & (value "ParallelismEnabledForQuery" of key "HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\BigFix\Enterprise Server\FillDB" of x32 registry as string)}  >> "{parameter "rootServerInfoFile"}"

else
waithidden cmd.exe /C echo Root Server information was not selected for capture. > "{parameter "diServerFolder" & "\ROOT_SERVER_INFO_NOT_SELECTED.txt"}"
endif

