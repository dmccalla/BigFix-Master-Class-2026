waithidden cmd.exe /C "{parameter "cliFolder" & "\iem"}" GET query --relevance=%22BES%20Relay%20Version%20Counts%3A%20%22%20%26%20concatenation%20%22%2C%20%22%20of%20%28it%20as%20string%29%20of%20%28it%20%26%20%22--%22%20%26%20%28multiplicity%20of%20it%20as%20string%29%29%20of%20unique%20values%20of%20values%20whose%20%28it%20contains%20%22.%22%29%20of%20results%20whose%20%28not%20error%20flag%20of%20it%20and%20exists%20value%20of%20it%29%20of%20bes%20property%20whose%20%28name%20of%20it%20%3D%20%22BES%20Relay%20Version%22%20and%20name%20of%20site%20of%20source%20analysis%20of%20it%20%3D%20%22BES%20Support%22%29%20as%20string >> {parameter "generalInfoFileXML"}
